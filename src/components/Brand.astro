---
interface Props {
  href?: string;
  current?: boolean;
}

const { href = '/', current = false } = Astro.props;
---

<a
  class="brand inline-flex shrink-0 items-center gap-1 text-[1.875rem] leading-none font-black tracking-[-0.13em] whitespace-nowrap text-white"
  href={href}
  aria-current={current ? 'page' : undefined}
  aria-label="IwetI, página inicial"
>
  <img
    class="brand-logo block h-[2.3rem] w-auto object-contain"
    src="/assets/images/logo-240.webp"
    width="240"
    height="80"
    alt="IwetI"
  />
  <small>
    TECNOLOGIA <br /> SEM LIMITES
  </small>
</a>

<style>
  @reference '../styles/styles.css';

  @layer utilities {
    .brand small {
      @apply mt-1 block text-[0.6rem] leading-none font-medium tracking-[0.18em] whitespace-nowrap;
    }

    @media (max-width: 380px) {
      .brand small {
        @apply hidden;
      }
    }
  }
</style>
