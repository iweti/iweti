---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a
  class="brand inline-flex shrink-0 items-center gap-1 text-[1.875rem] leading-none font-black tracking-[-0.13em] whitespace-nowrap text-white"
  href={href}
  aria-label="IwetI, página inicial"
>
  <img
    class="brand-logo block h-[2.3rem] w-auto object-contain"
    src="/assets/images/logo.png"
    alt="IwetI"
  />
  <small>TECNOLOGIA <br /> SEM LIMITES</small>
</a>
