---
interface Props {
  pages: { label: string; href: string; active: boolean }[];
}

const { pages } = Astro.props;
---

<nav class="header-page-indicator" aria-label="Localização nas páginas do site">
  {pages.map((page) => (
    <a
      href={page.href}
      aria-label={page.label}
      aria-current={page.active ? 'page' : undefined}
      data-astro-prefetch={page.href === '/blog' ? 'false' : undefined}
    >
      <span aria-hidden="true"></span>
    </a>
  ))}
</nav>
