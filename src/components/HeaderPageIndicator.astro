---
import { lateralPages, type SitePageId } from '../data/navigation';

interface Props {
  currentPage?: SitePageId;
}

const { currentPage } = Astro.props;
---

<nav class="header-page-indicator" aria-label="Localização nas páginas do site">
  {lateralPages.map((page) => (
    <a
      href={page.href}
      data-nav-page={page.id}
      aria-label={page.label}
      aria-current={page.id === currentPage ? 'page' : undefined}
      data-astro-prefetch={page.prefetch}
    >
      <span aria-hidden="true"></span>
    </a>
  ))}
</nav>
