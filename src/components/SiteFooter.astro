---
import Brand from './Brand.astro';
import { whatsappLink, whatsappNumber } from '../lib/whatsapp';

interface Props {
  home?: boolean;
  contactAnchor?: boolean;
  showCta?: boolean;
  currentPage?: 'privacy';
  ctaHref?: string;
}

const {
  home = false,
  contactAnchor = false,
  showCta = true,
  currentPage,
  ctaHref = '/contact',
} = Astro.props;

const whatsappHref = whatsappLink(whatsappNumber, 'Olá! Quero conversar sobre um projeto.');
---

<footer id={contactAnchor ? 'contato' : undefined} class="site-footer md:pt-14">
  {showCta && (
  <div class="footer-cta shell mb-9 flex flex-col items-start gap-6 pb-9 md:mb-12 md:flex-row md:items-center md:justify-between md:pb-12">
    <div>
      <h2>Vamos tirar o seu projeto do papel?</h2>
      <p>Fale com nosso time e descubra como a IwetI pode ajudar o seu negócio.</p>
    </div>
    <a class="btn btn-primary shrink-0" href={ctaHref}>
      Quero conversar agora →
    </a>
  </div>
  )}
  <div class="shell grid grid-cols-2 gap-x-6 gap-y-8 pb-9 md:grid-cols-4 md:gap-8 md:pb-12">
    <div class="col-span-2">
      <Brand href={home ? '#home' : '/'} />
      <p class="mt-5 mb-4 max-w-72 text-xs leading-[1.9] text-muted">
        Sites, sistemas e aplicações sob medida.
        <br />
        Tecnologia que conecta ideias e transforma negócios.
      </p>
      <span class="text-[0.65rem] text-cyan">Tecnologia sem limites.</span>
    </div>
    <nav aria-label="Explore a IWETI">
      <h3>Explore</h3>
      <a href={home ? '#home' : '/'}>Início</a>
      <a href="/portifolios">Nossos projetos</a>
      <a href="/about">Quem somos</a>
    </nav>
    <div>
      <h3>Vamos conversar</h3>
      <a class="footer-link" href="/contact">
        Fale conosco
      </a>
      <a class="footer-link break-all" href="mailto:contato@iweti.com">
        contato@iweti.com
      </a>
      {whatsappHref && (
        <a class="footer-link" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          WhatsApp<span class="sr-only"> (abre em nova aba)</span>
        </a>
      )}
    </div>
  </div>
  <div class="footer-bottom shell flex flex-col gap-3 border-t border-border py-5 text-[0.65rem] text-muted md:flex-row md:justify-between">
    <span>
      IWETI © {new Date().getFullYear()} · Desenvolvido por{' '}
      <a class="underline underline-offset-2 hover:text-cyan" href="/">
        IWETI
      </a>
    </span>
    <a
      class="hover:text-cyan"
      href="/privacy"
      aria-current={currentPage === 'privacy' ? 'page' : undefined}
    >
      Política de Privacidade
    </a>
  </div>
</footer>

<style>
  .site-footer h3 {
    margin: 0.25rem 0 1.25rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .site-footer nav > a,
  .footer-link {
    display: block;
    margin-block: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .site-footer nav > a:hover,
  .site-footer nav > a:focus-visible,
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-cyan);
  }
</style>
