---
import Brand from './Brand.astro';

interface Props {
  home?: boolean;
  contactAnchor?: boolean;
  currentPage?: 'privacy';
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  home = false,
  contactAnchor = false,
  currentPage,
  ctaLabel = 'Fale com a gente →',
  ctaHref = '/contact',
} = Astro.props;
---

<footer id={contactAnchor ? 'contato' : undefined}>
  <div class="footer-cta shell flex flex-col items-start justify-between gap-6 pb-10 lg:flex-row lg:items-center">
    <Brand href={home ? '#home' : '/'} />
    <div>
      <h2>Vamos tirar o seu projeto do papel?</h2>
      <p>Fale com nosso time e descubra como a IwetI pode ajudar o seu negócio.</p>
    </div>
    <a class="btn btn-primary" href={ctaHref}>
      {ctaLabel}
    </a>
  </div>
  <div class="footer-bottom shell flex flex-col gap-2 py-5 text-[0.65rem] text-[#64748b] md:flex-row md:justify-between">
    <span>
      IWETI © {new Date().getFullYear()} · Desenvolvido por <a href="https://iweti.com">IWETI</a>
    </span>
    <a href="/privacy" aria-current={currentPage === 'privacy' ? 'page' : undefined}>
      Política de Privacidade
    </a>
  </div>
</footer>
