---
import Brand from './Brand.astro';

interface Props {
  home?: boolean;
  currentPage?: 'about' | 'contact' | 'portifolios' | 'privacy';
}

const { home = false, currentPage } = Astro.props;
---

<header
  class:list={['site-header', { 'site-header-compact': !home }]}
  id={home ? 'home' : undefined}
>
  <nav class="shell nav" aria-label="Navegação principal">
    <Brand href={home ? '#home' : '/'} />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu">
      <span></span>
      <span></span>
      <span></span>
      <span class="sr-only">Abrir menu</span>
    </button>
    <div class="nav-links" id="menu">
      <a href="/portifolios" aria-current={currentPage === 'portifolios' ? 'page' : undefined}>
        Projetos
      </a>
      <a href="/about" aria-current={currentPage === 'about' ? 'page' : undefined}>
        Quem somos
      </a>
      <a
        class="nav-cta"
        href="/contact"
        aria-current={currentPage === 'contact' ? 'page' : undefined}
      >
        Fale com a gente →
      </a>
    </div>
  </nav>
  <slot />
</header>
