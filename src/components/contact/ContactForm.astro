---
import { whatsappLink, whatsappNumber } from '../../lib/whatsapp';

// This public URL is replaced at build time by Vercel. No API key is needed.
const apiUrl = import.meta.env.PUBLIC_API_URL?.trim() || 'https://api.iweti.com';
const hasWhatsapp = Boolean(whatsappLink(whatsappNumber, ''));
---

<form
  class="contact-form grid reveal gap-[1.15rem] rounded-xl border border-border p-6 md:p-8"
  aria-describedby="contact-help"
  data-api-url={apiUrl}
  data-whatsapp-number={hasWhatsapp ? whatsappNumber : undefined}
>
  <label for="contact-name">
    Nome
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      placeholder="Seu nome"
      maxlength="120"
      required
    />
  </label>
  <label for="contact-email">
    E-mail
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      placeholder="voce@exemplo.com"
      required
    />
  </label>
  <label for="contact-subject">
    Assunto
    <input
      id="contact-subject"
      name="subject"
      type="text"
      placeholder="Assunto da sua mensagem"
      maxlength="200"
      required
    />
  </label>
  <label for="contact-message">
    Como podemos ajudar?
    <textarea
      id="contact-message"
      name="message"
      placeholder="Escreva sua mensagem..."
      maxlength="10000"
      required
    ></textarea>
  </label>
  <label class="contact-newsletter" for="contact-newsletter">
    <input id="contact-newsletter" name="recebernovidades" type="checkbox" />
    <span>Quero receber novidades da IWETI ao enviar por e-mail.</span>
  </label>
  <p class="contact-help text-[0.72rem] leading-normal text-muted" id="contact-help">
    Preencha todos os campos para enviar sua mensagem. A inscrição em novidades está disponível no
    envio por e-mail.
  </p>
  <p
    class="contact-feedback text-[0.8rem] leading-[1.6] text-muted"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    hidden
  ></p>
  <div class="contact-actions grid justify-items-center gap-3">
    <button class="btn btn-primary" type="submit" data-contact-send="email" aria-disabled="true">
      <img src="/assets/images/email-icon.svg" alt="" aria-hidden="true" />
      <span data-contact-label>Enviar por e-mail</span>
    </button>
    {hasWhatsapp && (
      <>
        <span class="contact-actions-separator flex w-[min(100%,22rem)] items-center justify-center gap-3 text-[0.85rem] font-bold text-muted uppercase">
          ou
        </span>
        <button
          class="btn btn-ghost"
          type="button"
          data-contact-send="whatsapp"
          aria-disabled="true"
        >
          <img src="/assets/images/whatsapp-icon.svg" alt="" aria-hidden="true" />
          Enviar por WhatsApp
        </button>
      </>
    )}
  </div>
</form>

<noscript>
  <p class="contact-help text-[0.72rem] leading-normal text-muted">
    Ative o JavaScript para enviar sua mensagem pelo formulário.
  </p>
</noscript>

<script>
  import '../../scripts/contact';
</script>
