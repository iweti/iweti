---
import { whatsappLink, whatsappNumber } from '../../lib/whatsapp';

// This public URL is replaced at build time by Vercel. No API key is needed.
const apiUrl = import.meta.env.PUBLIC_API_URL?.trim() || 'https://api.iweti.com';
const hasWhatsapp = Boolean(whatsappLink(whatsappNumber, ''));
---

<form
  class="contact-form grid reveal gap-[1.15rem] rounded-xl border border-border p-6 md:p-8"
  aria-describedby="contact-help"
  data-api-url={apiUrl}
  data-whatsapp-number={hasWhatsapp ? whatsappNumber : undefined}
>
  <label for="contact-name">
    Nome
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      placeholder="Seu nome"
      maxlength="120"
      required
    />
  </label>
  <label for="contact-email">
    E-mail
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      placeholder="voce@exemplo.com"
      required
    />
  </label>
  <label for="contact-subject">
    Assunto
    <input
      id="contact-subject"
      name="subject"
      type="text"
      placeholder="Assunto da sua mensagem"
      maxlength="200"
      required
    />
  </label>
  <label for="contact-message">
    Como podemos ajudar?
    <textarea
      id="contact-message"
      name="message"
      placeholder="Escreva sua mensagem..."
      maxlength="10000"
      required
    ></textarea>
  </label>
  <label class="contact-newsletter" for="contact-newsletter">
    <input id="contact-newsletter" name="recebernovidades" type="checkbox" />
    <span>Quero receber novidades da IWETI ao enviar por e-mail.</span>
  </label>
  <p class="contact-help text-[0.72rem] leading-normal text-muted" id="contact-help">
    Preencha todos os campos para enviar sua mensagem. A inscrição em novidades está disponível no
    envio por e-mail.
  </p>
  <p
    class="contact-feedback text-[0.8rem] leading-[1.6] text-muted"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    hidden
  ></p>
  <div class="contact-actions grid justify-items-center gap-3">
    <button class="btn btn-primary" type="submit" data-contact-send="email" aria-disabled="true">
      <img src="/assets/images/email-icon.svg" alt="" aria-hidden="true" />
      <span data-contact-label>Enviar por e-mail</span>
    </button>
    {hasWhatsapp && (
      <>
        <span class="contact-actions-separator flex w-[min(100%,22rem)] items-center justify-center gap-3 text-[0.85rem] font-bold text-muted uppercase">
          ou
        </span>
        <button
          class="btn btn-ghost"
          type="button"
          data-contact-send="whatsapp"
          aria-disabled="true"
        >
          <img src="/assets/images/whatsapp-icon.svg" alt="" aria-hidden="true" />
          Enviar por WhatsApp
        </button>
      </>
    )}
  </div>
</form>

<noscript>
  <p class="contact-help text-[0.72rem] leading-normal text-muted">
    Ative o JavaScript para enviar sua mensagem pelo formulário.
  </p>
</noscript>

<script>
  import '../../scripts/contact';
</script>

<style>
  @reference '../../styles/styles.css';

  @layer utilities {
    .contact-form {
      background: var(--color-card);
      box-shadow: 0 18px 48px rgb(0 105 255 / 8%);
    }

    .contact-form label {
      @apply grid gap-2 text-[0.8rem] font-semibold text-[#e2e8f0];
    }

    .contact-form input,
    .contact-form textarea {
      @apply w-full;
      padding: 0.8rem 0.9rem;
      @apply rounded-lg border border-[rgb(0_141_255/28%)];
      outline: none;
      background: rgb(2 13 36 / 76%);
      @apply text-white;
      font: inherit;
      @apply text-[0.85rem];
      transition:
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .contact-form textarea {
      @apply min-h-40 resize-y;
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder {
      @apply text-[#7187a3];
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      @apply border-cyan;
      box-shadow: 0 0 0 3px rgb(0 216 255 / 12%);
    }

    .contact-form .btn {
      @apply justify-self-start border-0;
    }

    .contact-form label.contact-newsletter {
      @apply flex cursor-pointer items-start gap-[0.65rem] leading-normal;
    }

    .contact-form .contact-newsletter input {
      @apply h-4 w-4 flex-[0_0_auto] p-0;
      margin: 0.15rem 0 0;
      @apply accent-action;
    }

    .contact-feedback[data-state='success'] {
      @apply text-cyan;
    }

    .contact-feedback[data-state='error'],
    .contact-feedback[data-state='partial'] {
      @apply text-[#ffd6a3];
    }

    .contact-form .btn:disabled {
      @apply transform-none cursor-default opacity-70;
    }

    .contact-form .contact-actions .btn {
      @apply flex min-h-15 w-[min(100%,22rem)];
      padding: 1rem 1.5rem;
      @apply gap-[0.7rem] justify-self-center border-2 border-solid text-[0.85rem];
    }

    .contact-actions .btn img {
      @apply h-6 w-6 object-contain;
    }

    .contact-form [data-contact-send='email'] {
      @apply border-cyan/40 text-cyan;
      background: #061a2e;
    }

    .contact-form [data-contact-send='email']:hover {
      @apply border-cyan text-cyan;
      background: #0a2942;
    }

    .contact-form [data-contact-send='email'][aria-disabled='true']:hover {
      @apply border-cyan/40 text-cyan;
      background: #061a2e;
    }

    .contact-form [data-contact-send='whatsapp'] {
      @apply border-[#25d366];
      background: rgb(37 211 102 / 10%);
      @apply text-[#7aefa7];
    }

    .contact-form [data-contact-send='whatsapp']:hover {
      @apply border-[#25d366];
      background: #25d366;
      @apply text-[#062b15];
    }

    .contact-form [data-contact-send='whatsapp'][aria-disabled='true']:hover {
      @apply border-[#25d366];
      background: rgb(37 211 102 / 10%);
      @apply text-[#7aefa7];
    }

    .contact-actions-separator::before,
    .contact-actions-separator::after {
      @apply h-px flex-1;
      background: rgb(157 180 209 / 35%);
      @apply [content:''];
    }

    .contact-form .btn[aria-disabled='true'] {
      @apply cursor-not-allowed opacity-55;
    }

    .contact-form .btn[aria-disabled='true']:hover {
      @apply transform-none;
    }
  }
</style>
