---
import { projects } from '../../data/projects';

const covers: Record<string, string> = {
  Frattellianos: '/assets/images/portimages/Frattellianos/Frattellianos-main.png',
  Debinatos: '/assets/images/portimages/Debinatos/Debinatos-main.png',
};
---

<section
  class="portfolio home-projects section"
  id="portfolio"
  aria-labelledby="home-projects-title"
>
  <div class="home-projects-layout shell grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] grid-rows-[auto_auto] items-center gap-x-[clamp(2rem,5vw,5rem)] gap-y-7 max-md:grid-cols-[minmax(0,1fr)] max-md:grid-rows-[auto_auto_auto] max-md:gap-7">
    <div class="home-projects-heading col-1 row-1 max-w-100 self-end">
      <p class="eyebrow">NOSSO PORTFÓLIO</p>
      <h2 id="home-projects-title">Cada detalhe pensado para quem usa.</h2>
      <p class="home-projects-description mt-5 leading-[1.75] text-muted">
        Em cada projeto, pensamos na experiência de quem vai navegar. Do primeiro contato ao próximo
        clique, combinamos design, clareza e funcionalidade para tornar cada interação intuitiva e
        aproximar sua marca das pessoas.
      </p>
    </div>
    <div class="home-projects-visual col-2 row-[1/3] min-w-0 max-md:col-1 max-md:row-2 max-md:w-full max-md:justify-self-center">
      <div
        class="project-pillars flex h-[clamp(28rem,36vw,32rem)] gap-2.5 max-md:h-auto max-md:flex-col"
        data-project-pillars
      >
        {projects.map((project, index) => {
          const slug = project.name.toLowerCase().replace(/\s+/g, '-');
          const expanded = index === 0;
          return (
            <article
              class:list={[
                'project-pillar relative isolate min-w-11 flex-[1_1_0] overflow-hidden rounded-2xl border border-[rgb(157_180_209/24%)]',
                { 'is-active': expanded },
              ]}
              data-pillar
              data-project={slug}
              aria-labelledby={`pillar-${slug}-trigger`}
            >
              {covers[project.name] ? (
                <img
                  class="project-pillar-cover absolute inset-0 -z-2 h-[62%] w-full object-cover object-top-left opacity-45"
                  src={covers[project.name]}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <span
                  class="project-pillar-mark absolute top-[24%] left-5 -z-2 text-[clamp(4rem,7vw,7rem)] leading-none font-extrabold tracking-[-0.08em] text-white opacity-0 max-md:top-19 max-md:right-5 max-md:left-auto"
                  aria-hidden="true"
                >
                  {project.name === 'LivesRun' ? 'LR' : project.name === 'NSS Gym' ? 'NG' : 'JJ'}
                </span>
              )}
              <h3 class="project-pillar-heading text-[length:inherit] [font-weight:inherit]">
                <button
                  class="project-pillar-trigger absolute inset-0 w-full p-0 text-left"
                  id={`pillar-${slug}-trigger`}
                  type="button"
                  aria-expanded={expanded}
                  aria-controls={`pillar-${slug}-details`}
                >
                  <span
                    class="project-pillar-number absolute top-6 left-[50%] transform-[translateX(-50%)] text-[0.7rem] font-medium tracking-[0.08em] text-[#bed5ef]"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="project-pillar-name absolute bottom-6 left-[50%] transform-[translateX(-50%)_rotate(180deg)] text-[1rem] leading-[1.2] font-semibold whitespace-nowrap [writing-mode:vertical-rl]">
                    {project.name}
                  </span>
                  <span
                    class="project-pillar-toggle hidden max-md:relative max-md:block max-md:h-4 max-md:w-4"
                    aria-hidden="true"
                  ></span>
                </button>
              </h3>
              <div
                class="project-pillar-details invisible absolute right-5 bottom-5 left-5 transform-[translateY(0.5rem)] opacity-0 max-md:relative max-md:inset-auto max-md:grid max-md:transform-none max-md:grid-rows-[0fr]"
                id={`pillar-${slug}-details`}
                aria-hidden={!expanded}
                inert={!expanded}
              >
                <div class="project-pillar-details-inner max-md:min-h-0 max-md:overflow-hidden">
                  <div class="project-pillar-content">
                    <p class="project-pillar-category text-[0.65rem] leading-[1.6] tracking-widest text-[#bed5ef] uppercase">
                      {project.category}
                    </p>
                    <span class="project-pillar-status mt-3 inline-block rounded-4xl border border-[rgb(190_213_239/30%)] text-[0.65rem] leading-[1.4] text-[#d6e6f8]">
                      {project.status}
                    </span>
                    <p class="project-pillar-description mt-3.5 text-[0.85rem] leading-[1.7] text-[#d6e1ef]">
                      {project.description}
                    </p>
                    <a
                      class="project-pillar-link mt-3 inline-flex min-h-11 items-center gap-3 text-[0.8rem] font-semibold text-white"
                      href={`/portifolios#${slug}`}
                    >
                      Ver projeto <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
    <a
      class="home-projects-link col-1 row-2 btn self-start justify-self-start btn-primary max-md:row-3"
      href="/portifolios"
    >
      Ver projetos →
    </a>
  </div>
</section>

<script>
  import '../../scripts/project-pillars';
</script>
