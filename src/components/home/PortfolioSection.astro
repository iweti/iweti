---
import { sitePages } from '../../data/navigation';
import { projects } from '../../data/projects';

const covers: Record<string, string> = {
  Frattellianos: '/assets/images/portimages/Frattellianos/Frattellianos-main.png',
  Debinatos: '/assets/images/portimages/Debinatos/Debinatos-main.png',
};

const projectMarks: Record<string, string> = {
  LivesRun: 'LR',
  'NSS Gym': 'NG',
};
---

<section
  class="portfolio home-projects section"
  id="portfolio"
  aria-labelledby="home-projects-title"
>
  <div class="home-projects-layout shell grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] grid-rows-[auto_auto] items-center gap-x-[clamp(2rem,5vw,5rem)] gap-y-7 max-md:grid-cols-[minmax(0,1fr)] max-md:grid-rows-[auto_auto_auto] max-md:gap-7">
    <div class="home-projects-heading col-1 row-1 max-w-100 self-end">
      <p class="eyebrow">NOSSO PORTFÓLIO</p>
      <h2 id="home-projects-title">Cada detalhe pensado para quem usa.</h2>
      <p class="home-projects-description mt-5 leading-[1.75] text-muted">
        Em cada projeto, pensamos na experiência de quem vai navegar. Do primeiro contato ao próximo
        clique, combinamos design, clareza e funcionalidade para tornar cada interação intuitiva e
        aproximar sua marca das pessoas.
      </p>
    </div>
    <div class="home-projects-visual col-2 row-[1/3] min-w-0 max-md:col-1 max-md:row-2 max-md:w-full max-md:justify-self-center">
      <div
        class="project-pillars reveal flex h-[clamp(28rem,36vw,32rem)] gap-2.5 max-md:h-auto max-md:flex-col"
        data-project-pillars
      >
        {projects.map((project, index) => {
          const slug = project.slug;
          const expanded = index === 0;
          return (
            <article
              class:list={[
                'project-pillar relative isolate min-w-11 flex-[1_1_0] overflow-hidden rounded-2xl border border-[rgb(157_180_209/24%)]',
                { 'is-active': expanded },
              ]}
              data-pillar
              style={`--pillar-index: ${index}`}
              data-project={slug}
              aria-labelledby={`pillar-${slug}-trigger`}
            >
              {(covers[project.name] || project.cover) ? (
                <img
                  class="project-pillar-cover absolute inset-0 -z-2 h-[80%] w-full object-cover object-top-left opacity-100"
                  src={project.cover?.src ?? covers[project.name]}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <span
                  class="project-pillar-mark absolute top-[24%] left-5 -z-2 text-[clamp(4rem,7vw,7rem)] leading-none font-extrabold tracking-[-0.08em] text-white opacity-0 max-md:top-19 max-md:right-5 max-md:left-auto"
                  aria-hidden="true"
                >
                  {projectMarks[project.name] ?? 'JJ'}
                </span>
              )}
              <h3 class="project-pillar-heading text-[length:inherit] [font-weight:inherit]">
                <button
                  class="project-pillar-trigger absolute inset-0 w-full p-0 text-left"
                  id={`pillar-${slug}-trigger`}
                  type="button"
                  aria-expanded={expanded}
                  aria-controls={`pillar-${slug}-details`}
                >
                  <span class="project-pillar-name absolute bottom-6 left-[50%] transform-[translateX(-50%)_rotate(180deg)] text-[1rem] leading-[1.2] font-semibold whitespace-nowrap [writing-mode:vertical-rl]">
                    {project.name}
                  </span>
                  <span
                    class="project-pillar-toggle hidden max-md:relative max-md:block max-md:h-4 max-md:w-4"
                    aria-hidden="true"
                  ></span>
                </button>
              </h3>
              <div
                class="project-pillar-details invisible absolute right-5 bottom-5 left-5 transform-[translateY(0.5rem)] opacity-0 max-md:relative max-md:inset-auto max-md:grid max-md:transform-none max-md:grid-rows-[0fr]"
                id={`pillar-${slug}-details`}
                aria-hidden={!expanded}
                inert={!expanded}
              >
                <div class="project-pillar-details-inner max-md:min-h-0 max-md:overflow-hidden">
                  <div class="project-pillar-content">
                    <p class="project-pillar-category text-[0.65rem] leading-[1.6] tracking-widest text-[#bed5ef] uppercase">
                      {project.category}
                    </p>
                    <p class="project-pillar-description mt-1.5 text-[0.85rem] leading-[1.45] text-[#d6e1ef]">
                      {project.description}
                    </p>
                    <a
                      class="project-pillar-link mt-1 ml-auto flex min-h-11 w-fit items-center gap-3 text-[0.8rem] font-semibold text-white"
                      href={`/portifolios#${slug}`}
                    >
                      Ver projeto <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
    <a
      class="home-projects-link col-1 row-2 btn self-start justify-self-start btn-primary max-md:row-3"
      href={sitePages.portifolios.href}
    >
      Ver projetos →
    </a>
  </div>
</section>

<script>
  import '../../scripts/project-pillars';
</script>

<style>
  @reference '../../styles/styles.css';

  @layer utilities {
    .portfolio {
      background:
        radial-gradient(ellipse at 82% 12%, rgb(0 141 255 / 8%), transparent 26rem),
        var(--color-ink);
    }

    .home-projects {
      background:
        radial-gradient(ellipse at 75% 50%, rgb(0 126 255 / 8%), transparent 65%), var(--color-ink);
    }

    .home-projects-heading h2 {
      @apply mt-3 text-[clamp(2rem,4vw,3.25rem)] leading-[1.15] tracking-[-0.035em] text-balance;
    }

    .project-pillar {
      background: linear-gradient(155deg, #263d53, #07152b 75%);
      transition:
        flex-grow 600ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 350ms ease;
    }

    .project-pillars.visible .project-pillar {
      animation: pillar-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--pillar-index, 0) * 110ms);
    }

    @keyframes pillar-enter {
      from {
        opacity: 0;
        transform: translateY(2rem) scale(0.97);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .project-pillar[data-project='frattellianos'] {
      background: #221b1b;
    }

    .project-pillar[data-project='debinatos'] {
      background: #48443c;
    }

    .project-pillar[data-project='livesrun'] {
      background: radial-gradient(ellipse at 70% 30%, #286e6a, transparent 75%), #092b32;
    }

    .project-pillar[data-project='nss-gym'] {
      background: radial-gradient(ellipse at 70% 30%, #5a6730, transparent 75%), #202b22;
    }

    .project-pillar[data-project='jiu-jitsu'] {
      background: radial-gradient(ellipse at 70% 30%, #753e52, transparent 75%), #301d31;
    }

    .project-pillar::after {
      @apply absolute inset-0 -z-1 [content:''];
      background: linear-gradient(180deg, rgb(2 9 24 / 68%), rgb(2 9 24 / 15%) 20%, #041023 62%);
      @apply pointer-events-none;
    }

    .project-pillar:has(.project-pillar-cover)::after {
      background: linear-gradient(
        180deg,
        rgb(2 9 24 / 25%),
        transparent 25%,
        transparent 48%,
        #041023 80%
      );
    }

    .project-pillar.is-active {
      flex-grow: 4;
      @apply border-cyan/65;
    }

    .project-pillar-cover {
      transform: scale(1.06);
      transition:
        opacity 350ms ease,
        transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-pillar.is-active .project-pillar-cover {
      transform: scale(1);
      @apply opacity-100;
    }

    .project-pillar-mark {
      transition: opacity 350ms ease;
    }

    .project-pillar.is-active .project-pillar-mark {
      @apply opacity-18;
    }

    .project-pillar-trigger:focus-visible {
      @apply rounded-[0.9rem] outline-offset-[-5px];
    }

    .project-pillar.is-active .project-pillar-trigger {
      @apply bottom-auto h-24;
    }

    .project-pillar.is-active .project-pillar-name {
      @apply top-6 bottom-auto left-5 max-w-[calc(100%-2.5rem)] transform-none text-[clamp(1.15rem,1.7vw,1.65rem)] wrap-anywhere whitespace-normal [writing-mode:horizontal-tb];
    }

    .project-pillar-details {
      transition:
        opacity 350ms ease,
        transform 350ms ease,
        visibility 350ms;
    }

    .project-pillar.is-active .project-pillar-details {
      @apply visible transform-none opacity-100;
    }

    .project-pillar-link:hover {
      @apply underline underline-offset-[0.25em];
    }

    @media (max-width: 767px) {
      .project-pillar,
      .project-pillar.is-active {
        @apply min-w-0 flex-none;
      }

      .project-pillar::after {
        background: linear-gradient(180deg, rgb(2 9 24 / 65%), #041023 4.75rem);
      }

      .project-pillar:has(.project-pillar-cover)::after {
        background: linear-gradient(180deg, rgb(2 9 24 / 40%), transparent 35%, #041023 85%);
      }

      .project-pillar-trigger,
      .project-pillar.is-active .project-pillar-trigger {
        @apply relative inset-auto grid h-auto min-h-19 grid-cols-[minmax(0,1fr)_1rem] items-center gap-3;
        padding: 1rem 1.25rem;
      }

      .project-pillar-name,
      .project-pillar.is-active .project-pillar-name {
        @apply static max-w-none transform-none [writing-mode:horizontal-tb];
      }

      .project-pillar-name,
      .project-pillar.is-active .project-pillar-name {
        @apply text-[1.1rem];
      }

      .project-pillar-toggle::before,
      .project-pillar-toggle::after {
        @apply absolute top-[calc(50%-1px)] h-0.5 w-full [content:''];
        background: #bed5ef;
      }

      .project-pillar-toggle::after {
        @apply transform-[rotate(90deg)];
        transition: transform 350ms ease;
      }

      .project-pillar.is-active .project-pillar-toggle::after {
        @apply transform-[rotate(0)];
      }

      .project-pillar-details {
        transition:
          grid-template-rows 350ms ease,
          opacity 350ms ease,
          visibility 350ms;
      }

      .project-pillar.is-active .project-pillar-details {
        @apply grid-rows-[1fr];
      }

      .project-pillar-content {
        padding: 0 1.25rem 1.25rem;
      }
    }


    @media (min-width: 768px) {
      .project-pillar.is-active { background: #07152b; }
      .project-pillar.is-active::after { background: none; }
      .project-pillar.is-active .project-pillar-cover {
        height: 61%;
        object-position: center;
      }
      .project-pillar.is-active .project-pillar-trigger {
        top: 61%;
        height: 3rem;
      }
      .project-pillar.is-active .project-pillar-name { top: 0.8rem; }
      .project-pillar.is-active .project-pillar-details { bottom: 0.65rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .project-pillars *,
      .project-pillars *::before,
      .project-pillars *::after {
        animation: none !important;
        transition: none;
      }
    }
  }
</style>
