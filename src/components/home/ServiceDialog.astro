---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog
  class="service-dialog max-h-[min(80vh,42rem)] w-[min(34rem,calc(100%-2rem))] origin-center overflow-auto rounded-2xl border border-[rgb(0_141_255/45%)] p-0 text-white opacity-100"
  id={`service-dialog-${id}`}
  aria-labelledby={`service-title-${id}`}
>
  <div class="service-dialog-content relative p-[clamp(1.5rem,5vw,2.5rem)]">
    <button
      class="service-dialog-close absolute top-4 right-4 grid h-10 w-10 place-items-center rounded-full border border-border text-[1.5rem] leading-none text-white"
      type="button"
      aria-label="Fechar"
    >
      ×
    </button>
    <p class="eyebrow">SAIBA MAIS</p>
    <h2 id={`service-title-${id}`}>{title}</h2>
    <div class="service-dialog-body mt-5 grid gap-4 text-[0.9rem] leading-[1.7] wrap-anywhere text-muted">
      <slot />
    </div>
  </div>
</dialog>

<style>
  @reference '../../styles/styles.css';

  @layer utilities {
    .service-dialog {
      background:
        radial-gradient(ellipse at 82% 12%, rgb(0 141 255 / 12%), transparent 26rem),
        var(--color-card);
      box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
      transition:
        transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1),
        opacity 220ms ease;
    }

    .service-dialog::backdrop {
      background: rgb(1 8 22 / 78%);
      backdrop-filter: blur(5px);
    }

    .service-dialog-content .eyebrow {
      @apply mb-3;
    }

    .service-dialog-content h2 {
      @apply max-w-96 pr-8 text-[clamp(1.5rem,5vw,2rem)] leading-[1.2] wrap-anywhere;
    }

    .service-dialog-close:hover,
    .service-dialog-close:focus-visible {
      @apply border-cyan text-cyan;
    }

    @media (prefers-reduced-motion: reduce) {
      .service-dialog {
        transition: none;
      }
    }
  }
</style>
