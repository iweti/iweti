---
import TestimonialCard from './TestimonialCard.astro';

const testimonials = [
  {
    name: 'Mariana Silva',
    quote: 'A IwetI entregou exatamente o que precisávamos. Profissionais competentes e um atendimento incrível!',
  },
  {
    name: 'Ricardo Almeida',
    quote: 'Nosso sistema foi desenvolvido sob medida e hoje facilita todas as operações. Recomendo de olhos fechados!',
  },
  {
    name: 'Carla Mendes',
    quote: 'Excelente parceria! Tecnologia, agilidade e resultado de verdade.',
  },
];
---

<section class="testimonials section" id="depoimentos">
  <div class="shell">
    <div class="section-heading mb-18 flex reveal items-center justify-center gap-8 text-center">
      <h2>
        <span class="text-cyan text-[1.2em]">IWETI</span>
        <br />
        Quem conhece,
        recomenda.
      </h2>
    </div>
    <div class="quote-grid grid gap-4 md:grid-cols-[repeat(3,1fr)]">
      {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
    </div>
  </div>
</section>
