<dialog
  class="external-site-confirmation m-auto w-[min(28rem,calc(100%-2rem))] rounded-2xl border border-border p-8 text-white"
  aria-labelledby="external-site-title"
  aria-describedby="external-site-message"
>
  <h2 id="external-site-title">Você está saindo do site da IwetI</h2>
  <p id="external-site-message">
    Você será direcionado para <strong class="external-site-url text-white"></strong>. Deseja
    prosseguir?
  </p>
  <div class="external-site-actions mt-6 flex justify-end gap-3">
    <button class="external-site-cancel" type="button">
      Não
    </button>
    <a
      class="external-site-confirm m-0 btn border-transparent btn-primary"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
    >
      Sim
    </a>
  </div>
</dialog>

<style>
  @reference '../../styles/styles.css';

  @layer utilities {
    .external-site-confirmation {
      background:
        radial-gradient(ellipse at 82% 12%, rgb(0 141 255 / 12%), transparent 18rem),
        var(--color-card);
      box-shadow: 0 24px 80px rgb(0 0 0 / 65%);
    }

    .external-site-confirmation::backdrop {
      background: rgb(1 8 22 / 78%);
      backdrop-filter: blur(5px);
    }

    .external-site-confirmation h2 {
      @apply text-[1.35rem] leading-[1.3];
    }

    .external-site-confirmation p {
      @apply mt-3 leading-[1.6] wrap-anywhere text-muted;
    }

    .external-site-actions button,
    .external-site-confirm {
      @apply min-w-20;
      padding: 0.7rem 1rem;
      @apply rounded-lg border border-border text-white;
      font: inherit;
      @apply cursor-pointer text-center text-[0.85rem] font-bold;
    }

    .external-site-confirm {
      @apply border-transparent;
    }

    .external-site-actions button {
      background: transparent;
    }

    .external-site-actions button:hover,
    .external-site-actions button:focus-visible {
      @apply border-cyan;
      outline: 2px solid var(--color-cyan);
      @apply outline-offset-2;
    }
  }
</style>
