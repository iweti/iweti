<dialog
  class="external-site-confirmation"
  aria-labelledby="external-site-title"
  aria-describedby="external-site-message"
>
  <h2 id="external-site-title">Você está saindo do site da IwetI</h2>
  <p id="external-site-message">
    Você será direcionado para <strong class="external-site-url"></strong>. Deseja prosseguir?
  </p>
  <div class="external-site-actions">
    <button class="external-site-cancel" type="button">
      Não
    </button>
    <a
      class="external-site-confirm btn btn-primary"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
    >
      Sim
    </a>
  </div>
</dialog>
