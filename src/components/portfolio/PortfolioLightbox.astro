<dialog class="portfolio-lightbox" aria-label="Galeria de imagens do portfólio">
  <div class="portfolio-lightbox-content">
    <button class="portfolio-lightbox-close" type="button" aria-label="Fechar galeria">
      ×
    </button>
    <div class="portfolio-lightbox-layout">
      <div class="portfolio-lightbox-viewer">
        <button class="portfolio-lightbox-prev" type="button" aria-label="Foto anterior"></button>
        <img class="portfolio-lightbox-image-background" alt="" aria-hidden="true" />
        <img class="portfolio-lightbox-image" alt="" />
        <button class="portfolio-lightbox-next" type="button" aria-label="Próxima foto"></button>
      </div>
      <div class="portfolio-lightbox-details">
        <span class="portfolio-lightbox-category"></span>
        <h2 class="portfolio-lightbox-title"></h2>
        <p class="portfolio-lightbox-description"></p>
        <a class="portfolio-lightbox-link" target="_blank" rel="noopener noreferrer">
          Acessar projeto →
        </a>
      </div>
    </div>
  </div>
</dialog>
