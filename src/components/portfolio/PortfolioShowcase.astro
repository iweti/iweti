---
import { projects } from '../../data/projects';

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;

const Heading = standalone ? 'h1' : 'h2';
---

<section
  class:list={[
    'project-showcase w-full p-[clamp(3rem,6vw,5rem)_max(1rem,calc((100%-1120px)/2))]',
    { 'project-showcase-page': standalone },
  ]}
  id="portfolio"
  aria-label="Nosso portfólio"
>
  <header class="project-heading mb-12 max-w-160">
    <p class="eyebrow">NOSSO PORTFÓLIO</p>
    <Heading>Projetos selecionados</Heading>
    <p>Conheça nossos sites, aplicativos e plataformas digitais.</p>
  </header>
  <div class="project-list">
    {projects.map((project) => (
      <article
        class="project-entry"
        id={project.name.toLowerCase().replace(/\s+/g, '-')}
        data-project-name={project.name}
        aria-labelledby={`${project.name.toLowerCase().replace(/\s+/g, '-')}-title`}
      >
        <div
          class="project-preview flex aspect-16/10 min-h-68 w-full min-w-0 flex-col items-start justify-between rounded-2xl border border-border p-[clamp(1.25rem,4vw,2.5rem)]"
          data-project={project.name.toLowerCase().replace(/\s+/g, '-')}
        >
          <span class="project-status rounded-4xl border border-border text-[0.75rem]">
            {project.status}
          </span>
          <span
            class="project-preview-name max-w-full text-[clamp(2rem,5vw,3.5rem)] font-semibold tracking-[-0.04em] wrap-anywhere"
            aria-hidden="true"
          >
            {project.name}
          </span>
          <span class="project-preview-category text-[0.85rem] text-muted">{project.category}</span>
        </div>
        <div class="project-caption mt-[clamp(2rem,5vw,3rem)]">
          <p class="project-category mb-3 text-[0.65rem] tracking-[0.14em] text-muted uppercase">
            {project.category}
          </p>
          <h2 id={`${project.name.toLowerCase().replace(/\s+/g, '-')}-title`}>{project.name}</h2>
          <div class="project-description mt-4 flex items-start justify-between gap-8 max-[601px]:flex-col max-[601px]:gap-3">
            <p>{project.description}</p>
            {project.url && (
              <a
                class="project-link inline-flex min-h-11 shrink-0 items-center gap-3 text-[0.9rem] text-text-primary"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Acessar site <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import '../../scripts/portfolio';
</script>
