---
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const projects = [
  {
    name: 'Frattellianos',
    description: 'Uma presença digital com a essência, a história e a identidade da marca.',
    url: 'https://frattellianos.com',
    category: 'Site institucional',
    status: '',
  },
  {
    name: 'Debinatos',
    description:
      'Identidade e conteúdo em uma experiência digital feita para apresentar o negócio.',
    url: 'https://debinatos.com',
    category: 'Site institucional',
    status: '',
  },
  {
    name: 'LivesRun',
    description:
      'Aplicativo esportivo com telas de atividades, histórico e perfil. MVP navegável com dados demonstrativos.',
    category: 'Aplicativo esportivo',
    status: 'MVP',
    url: null,
  },
  {
    name: 'NSS Gym',
    description: 'Projeto de aplicativo para academia, em fase inicial de desenvolvimento.',
    category: 'Aplicativo para academia',
    status: 'Em desenvolvimento',
    url: null,
  },
  {
    name: 'Jiu-jitsu',
    description:
      'Protótipo de plataforma para descobrir eventos e acompanhar a comunidade do jiu-jitsu, com dados demonstrativos.',
    category: 'Plataforma esportiva',
    status: 'Protótipo',
    url: null,
  },
];
const Heading = standalone ? 'h1' : 'h2';
---

<section
  class:list={['project-showcase', { 'project-showcase-page': standalone }]}
  id="portfolio"
  aria-label="Nosso portfólio"
>
  <header class="project-heading">
    <p class="eyebrow">NOSSO PORTFÓLIO</p>
    <Heading>Projetos selecionados</Heading>
    <p>Conheça nossos sites, aplicativos e plataformas digitais.</p>
  </header>
  <div class="project-list">
    {projects.map((project, index) => (
      <article
        class="project-entry"
        id={project.name.toLowerCase().replace(/\s+/g, '-')}
        data-project-name={project.name}
        aria-labelledby={`${project.name.toLowerCase().replace(/\s+/g, '-')}-title`}
      >
        {project.url ? (
          <div
            class="project-devices"
            aria-label={`Interface do projeto ${project.name} em notebook e celular`}
          >
            {['main', 'hist'].map((view, imageIndex) => (
              <div
                class="project-device-set"
                hidden={imageIndex !== 0}
                data-view-image={imageIndex}
              >
                <div class="project-device project-laptop">
                  <div class="laptop-lid">
                    <div class="device-screen">
                      <img
                        data-original
                        src={`/assets/images/portimages/${project.name}/${project.name}-${view}.png`}
                        alt={`${imageIndex === 0 ? 'Página principal' : 'Página de história'} do site ${project.name} em um notebook`}
                        loading={standalone && index === 0 && imageIndex === 0 ? 'eager' : 'lazy'}
                      />
                    </div>
                  </div>
                  <div class="laptop-base" aria-hidden="true"></div>
                </div>
                <div class="project-device project-phone" aria-hidden="true">
                  <div class="device-screen">
                    <img
                      src={`/assets/images/portimages/${project.name}/${project.name}-${view}-mobile.png`}
                      alt=""
                      loading="lazy"
                    />
                  </div>
                  <div class="phone-camera"></div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div
            class="project-preview"
            data-project={project.name.toLowerCase().replace(/\s+/g, '-')}
          >
            <span class="project-status">{project.status}</span>
            <span class="project-preview-name" aria-hidden="true">
              {project.name}
            </span>
            <span class="project-preview-category">{project.category}</span>
          </div>
        )}
        <div class="project-caption">
          <p class="project-category">{project.category}</p>
          <h2 id={`${project.name.toLowerCase().replace(/\s+/g, '-')}-title`}>{project.name}</h2>
          <div class="project-description">
            <p>{project.description}</p>
            {project.url && (
              <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
                Acessar site <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import '../../scripts/portfolio';
</script>
