---
import '../styles/styles.css';
import type { ComponentProps } from 'astro/types';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BlogIntro from '../components/blog/BlogIntro.astro';
import BlogCards from '../components/blog/BlogCards.astro';
import { blogPageSize, getBlogPosts } from '../lib/blog';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  currentPage?: ComponentProps<typeof SiteHeader>['currentPage'];
  footer?: Omit<ComponentProps<typeof SiteFooter>, 'home' | 'currentPage'>;
}

const { title, description, home = false, currentPage, footer = {} } = Astro.props;
const previewPosts =
  currentPage === 'blog' || currentPage === 'privacy' ? undefined : await getBlogPosts();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <ClientRouter fallback="swap" />
    <title>{title}</title>
    <link rel="icon" type="image/jpg" href="/assets/images/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader home={home} currentPage={currentPage} />
    <div class:list={['page-content', { 'page-content-home': home }]}>
      {home && (
        <div class="home-hero relative min-h-170 overflow-hidden max-[901px]:min-h-0" id="home">
          <slot name="hero" />
        </div>
      )}
      <slot />
      <SiteFooter
        {...footer}
        home={home}
        currentPage={currentPage === 'privacy' ? 'privacy' : undefined}
      />
    </div>
    <template data-blog-preview>
      <div class="page-content blog-preview">
        <section class="blog-page min-h-[calc(100vh-12rem)] py-20">
          <div class="shell">
            <BlogIntro />
            {previewPosts && (
              <div data-blog-preview-cards>
                <div data-blog-controls hidden class="mx-auto mb-6 max-w-232 text-center">
                  <p role="status">Não foi possível abrir a listagem completa.</p>
                  <div class="mt-3 flex justify-center gap-5">
                    <button type="button" data-blog-retry class="underline">
                      Tentar novamente
                    </button>
                    <button type="button" data-blog-cancel class="underline">
                      Voltar
                    </button>
                  </div>
                </div>
                <BlogCards
                  posts={previewPosts.slice(0, blogPageSize)}
                  page={1}
                  totalPages={Math.ceil(previewPosts.length / blogPageSize)}
                />
              </div>
            )}
          </div>
        </section>
      </div>
    </template>
    <div
      class="page-journey-overlay"
      data-page-journey
      transition:persist="page-journey"
      hidden
      aria-hidden="true"
      inert
    ></div>
    <script>
      import '../scripts/page-transitions';
      import '../scripts/navigation';
      import '../scripts/reveal';
    </script>
  </body>
</html>
