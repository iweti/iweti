---
import '../styles/styles.css';
import type { ComponentProps } from 'astro/types';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Home from '../components/panels/Home.astro';
import About from '../components/panels/About.astro';
import Projects from '../components/panels/Projects.astro';
import Blog from '../components/panels/Blog.astro';
import Contact from '../components/panels/Contact.astro';
import Privacy from '../components/panels/Privacy.astro';
const panels = [
  {
    path: '/',
    component: Home,
    title: 'IwetI | Tecnologia sem limites',
    description: 'IwetI - tecnologia, ideias e resultados sem limites.',
  },
  {
    path: '/about',
    component: About,
    title: 'Quem somos | IwetI',
    description:
      'Conheça a IwetI, nossa missão e visão e o significado de inovação, pessoas e tecnologia em nosso nome.',
  },
  {
    path: '/portifolios',
    component: Projects,
    title: 'Projetos | IwetI',
    description: 'Conheça projetos de sites e soluções digitais desenvolvidos pela IwetI.',
  },
  {
    path: '/blog',
    component: Blog,
    title: 'Blog | IwetI',
    description: 'Blog da IwetI sobre tecnologia, inovação e soluções digitais.',
  },
  {
    path: '/contact',
    component: Contact,
    title: 'Contato | IwetI',
    description: 'Entre em contato com a IwetI para conversar sobre seu próximo projeto.',
  },
  {
    path: '/privacy',
    component: Privacy,
    title: 'Política de Privacidade | IwetI',
    description: 'Política de privacidade da IwetI.',
  },
];

interface Props {
  title: string;
  description: string;
  home?: boolean;
  currentPage?: ComponentProps<typeof SiteHeader>['currentPage'];
  footer?: Omit<ComponentProps<typeof SiteFooter>, 'home' | 'currentPage'>;
}

const { title, description, home = false, currentPage } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/jpg" href="/assets/images/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader home={home} currentPage={currentPage} />
    <div data-panels>
      <div data-panel-track>
        {panels.map(({ path, component: Panel, title, description }) => (
          <div
            data-panel={path}
            data-title={title}
            data-description={description}
            class:list={['page-content', { 'page-content-home': path === '/' }]}
            hidden={Astro.url.pathname.replace(/\/$/, '') !== path.replace(/\/$/, '')}
            inert={Astro.url.pathname.replace(/\/$/, '') !== path.replace(/\/$/, '')}
            aria-hidden={
              Astro.url.pathname.replace(/\/$/, '') !== path.replace(/\/$/, '') ? 'true' : 'false'
            }
          >
            <Panel />
            <SiteFooter
              home={path === '/'}
              contactAnchor={path === '/' || path === '/portifolios'}
              showCta={path !== '/contact'}
              currentPage={path === '/privacy' ? 'privacy' : undefined}
            />
          </div>
        ))}
      </div>
    </div>
    <script>
      import '../scripts/page-transitions';
      import '../scripts/navigation';
      import '../scripts/reveal';
    </script>
  </body>
</html>
