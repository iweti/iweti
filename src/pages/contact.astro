---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
---

<BaseLayout
  currentPage="contact"
  footer={{ ctaLabel: 'contato@iweti.com', ctaHref: 'mailto:contato@iweti.com' }}
  title="Contato | IwetI"
  description="Entre em contato com a IwetI para conversar sobre seu próximo projeto."
>
  <main>
    <section class="contact-page">
      <div class="shell contact-layout">
        <div class="contact-intro reveal">
          <p class="eyebrow">FALE COM A IWETI</p>
          <h1>Vamos conversar sobre o seu projeto?</h1>
          <p class="contact-description">
            Preencha seus dados e conte um pouco sobre o que você precisa. Nossa equipe terá prazer
            em conversar com você.
          </p>
          <img
            class="contact-mascot"
            src="/assets/images/mascot-about.png"
            alt="Mascote IwetI trabalhando em um notebook"
            loading="lazy"
          />
        </div>
        <ContactForm />
      </div>
    </section>
  </main>
</BaseLayout>
